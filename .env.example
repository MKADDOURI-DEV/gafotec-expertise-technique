# ---- Browser-visible (public by design). Set in Vercel > Settings > Environment Variables (and in a local .env)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only after the Google provider is configured in Supabase Auth (leave false otherwise)
VITE_ENABLE_GOOGLE_LOGIN=false

# ---- Server only. NEVER prefix with VITE_, never commit.
# SUPABASE_URL is optional (falls back to VITE_SUPABASE_URL).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
