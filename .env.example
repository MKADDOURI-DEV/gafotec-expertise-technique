# Build-time (public by design; set them in the Cloudflare build environment and in a local .env)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only after the Google provider is configured in Supabase Auth
VITE_ENABLE_GOOGLE_LOGIN=false

# Runtime SECRETS: Cloudflare Worker secrets (never in Git, never prefixed VITE_)
#   wrangler secret put SUPABASE_URL
#   wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# For local development put them in .dev.vars (git-ignored).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
